; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scaled Clock"
config/description="1日をN×24時間に引き伸ばした倍速時計盤"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

MCPRuntimeBridge="*res://addons/godot_mcp/services/mcp_runtime_bridge.gd"
MCPInputBridge="*res://addons/godot_mcp/services/mcp_input_bridge.gd"
MCPScreenshotBridge="*res://addons/godot_mcp/services/mcp_screenshot_bridge.gd"

[display]

window/size/viewport_width=1170
window/size/viewport_height=2532
window/size/window_width_override=480
window/size/window_height_override=1039
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[gui]

theme/custom_font="res://theme/fonts/NotoSansJP-VariableFont_wght.ttf"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
